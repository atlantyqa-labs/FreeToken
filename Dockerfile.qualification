# syntax=docker/dockerfile:1.7
FROM nvidia/cuda:13.0.1-devel-ubuntu24.04
ARG SOURCE_SHA=2757bb5f91156fc8a44d88ec4b302a81f10c9e81
LABEL org.opencontainers.image.source="https://github.com/atlantyqa-labs/FreeToken" org.opencontainers.image.revision="$SOURCE_SHA" org.opencontainers.image.licenses="Apache-2.0"
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git python3 python3-venv pciutils && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"
WORKDIR /src
COPY . .
RUN uv venv /opt/venv && . /opt/venv/bin/activate && uv pip install ".[accel]"
ENV PATH="/opt/venv/bin:$PATH"
ENTRYPOINT ["ft"]
